{
  "//": "根配置：覆盖 electron.vite.config.ts / vitest.config.ts 等项目根文件。",
  "//2": "tsconfig.json 是 solution 风格（files:[] + references），tsc --noEmit 只查引用项目、不查根文件本身；",
  "//3": "加这个独立配置才能真正检查根文件（QA 实测：往 hash.ts 注入类型错误，原根配置 exit 0）。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
