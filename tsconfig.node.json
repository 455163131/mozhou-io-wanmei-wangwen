{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      // tests/ 归本项目管；渲染层的纯逻辑（zustand store）不含 DOM，
      // 可在 node 环境直接测。加此映射打通「渲染层逻辑可测」，不必引入 jsdom。
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    // composite 项目要求被引用的实现文件出现在 include 里（否则 TS6307）。
    // 只纳入 DOM-free 的渲染层逻辑：store 是纯状态机，inline-marks 是纯区间映射
    // （不碰 document/窗口，只算偏移），组件/hooks 仍归 tsconfig.web.json。
    // lib/theme.ts 同此例：它被 store 引用，且**必须**保持 DOM-free——
    // 碰浏览器的部分在 lib/theme-dom.ts（只归 web）。这条由
    // tests/unit/theme-ink.test.ts 的 D 组钉住，不靠人记得。
    "src/renderer/store/**/*.ts",
    "src/renderer/lib/theme.ts",
    "src/renderer/components/editor/inline-marks.ts",
    "tests/**/*.ts",
    "electron.vite.config.ts"
  ],
  // 与 vitest.config.ts 的 `exclude: ['**/_*.test.ts']` 保持一致：
  // 下划线前缀 = 临时探针，跑完即删，既不进用例数、也不该打断 typecheck。
  "exclude": ["tests/**/_*.test.ts"]
}