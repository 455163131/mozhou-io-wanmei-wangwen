{
  "name": "mozhou-agent",
  "version": "0.1.0",
  "description": "木萱写作",
  "main": "out/main/index.js",
  "type": "commonjs",
  "author": "墨舟",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.root.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "scripts\\test.cmd run",
    "test:watch": "scripts\\test.cmd",
    "test:coverage": "scripts\\test.cmd run --coverage",
    "pack:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
